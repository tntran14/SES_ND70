				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA["BIÊN BẢN "+ (($P{IsThayThe} != null && $P{IsThayThe}) ? "THAY THẾ" : "ĐIỀU CHỈNH") +" HÓA ĐƠN ĐIỆN TỬ CÓ SAI SÓT"]]></textFieldExpression>
