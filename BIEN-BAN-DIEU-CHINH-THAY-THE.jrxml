	<pageHeader>
		<band height="109" splitType="Stretch">
			<textField>
				<reportElement x="10" y="1" width="534" height="88" uuid="ef3f8064-3358-41a2-8699-ff9802a8853b"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA["- Căn cứ Thông tư 91/2026/TT-BTC quy định một số điều của Luật Quản lý thuế, hướng dẫn thi hành Nghị định số 254/2026/NĐ-CP của Chính phủ quy định chi tiết một số điều về hóa đơn điện tử, chứng từ điện tử, có hiệu lực kể từ ngày 01/07/2026."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="10" y="89" width="534" height="16" uuid="35e44d4f-38f0-4f19-870d-5b2a9d84702b"/>
				<textElement>
					<font fontName="Times New Roman" size="12" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA["Hôm nay, ngày " + (null == $P{Day} ? "....." : $P{Day}) + " tháng " + (null == $P{Month} ? "....." : $P{Month}) + " năm " + (null == $P{Year} ? "....." : $P{Year}) + " hai bên chúng tôi gồm có:"]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>
